# Copie ce fichier vers .env puis remplace toutes les valeurs factices.
# Ne committe jamais le fichier .env ni de vraies clés ou mots de passe.

DATABASE_URL="postgresql://USER:REPLACE_ME@localhost:5432/support_tickets?schema=public"
TEST_DATABASE_URL="postgresql://USER:REPLACE_ME@localhost:5432/support_ticket_test?schema=public"

JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

SUPER_ADMIN_EMAIL="admin@example.test"
SUPER_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
SUPER_ADMIN_NAME="Super Admin"

RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Support Ticket <support@your-verified-domain.com>"

OPENAI_API_KEY="sk-your-api-key-here"
OPENAI_MODEL="gpt-6-astra"

APP_BASE_URL="http://localhost:3000"
PORT="3000"
